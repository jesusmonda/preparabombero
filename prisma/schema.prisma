generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   Int      @id @default(autoincrement())
  email                String   @unique
  name                 String
  surname              String
  password             String
  role                 UserRole @default(USER)
  subscribed           Boolean  @default(false)
  subscription_id      String?
  cancellation_pending Boolean  @default(false)
  token                String   @default(uuid())

  studyPlanId       Int?
  examEstimatedDate DateTime?

  studyPlan         StudyPlan?         @relation(fields: [studyPlanId], references: [id], onDelete: SetNull)
  ips               Ip[]
  quizStats         QuizStat[]
  quizFavorite      QuizFavorite[]
  studyPlanSessions StudyPlanSession[]
}

model Pdf {
  id        Int     @id @default(autoincrement())
  community String?
  city      String
  year      String
  type      String?
  subtype   String?
  name      String
  quizzes   Quiz[]
}

model Ip {
  id     Int    @id @default(autoincrement())
  ip     String
  userId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Topic {
  id            Int      @id @default(autoincrement())
  title         String
  url           String?
  categoryTitle String?
  parentId      Int?
  created_at    DateTime @default(now())
  order         Int

  quizzes         Quiz[]
  parent          Topic?           @relation("Topics", fields: [parentId], references: [id], onDelete: Cascade)
  topics          Topic[]          @relation("Topics")
}

model Quiz {
  id            Int      @id @default(autoincrement())
  title         String
  option1       String
  option2       String
  option3       String
  option4       String
  result        String
  topicId       Int?
  justification String?
  created_at    DateTime @default(now())
  pdf_name      String?
  pdfId         Int      @default(0)

  topic             Topic?          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  pdf               Pdf             @relation(fields: [pdfId], references: [id], onDelete: Restrict)
  reports           Report[]
  quizzes_favorites QuizFavorite[]
  studyPlanQuizzes  StudyPlanQuiz[]
}

model QuizFavorite {
  id     Int @id @default(autoincrement())
  userId Int
  quizId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Restrict)
}

model QuizStat {
  id           Int      @id @default(autoincrement())
  userId       Int
  success      Int
  fail         Int
  not_answered Int
  created_at   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudyPlan {
  id        Int    @id @default(autoincrement())
  community String
  city      String
  type      String

  users             User[]
  studyPlanTopics   StudyPlanTopic[]
  studyPlanSessions StudyPlanSession[]

  @@index([community, city, type])
}

enum StudyPlanTopicType {
  ESPECIFICO
  LEGISLACION
  TERRITORIAL
}

model StudyPlanTopic {
  id          Int                @id @default(autoincrement())
  studyPlanId Int
  topicId     Int[]
  topicName   String
  type        StudyPlanTopicType

  studyPlan StudyPlan @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)

  @@index([studyPlanId, type])
}

model StudyPlanSession {
  id                       Int                    @id @default(autoincrement())
  studyPlanId              Int
  userId                   Int
  studyPlanTopicIds        Int[]
  date                     DateTime
  type                     StudyPlanSessionType
  percentage               Float?

  studyPlan StudyPlan       @relation(fields: [studyPlanId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizzes   StudyPlanQuiz[]

  @@unique([userId, studyPlanId, date])
  @@index([userId, date])
}

model StudyPlanQuiz {
  id                 Int     @id @default(autoincrement())
  studyPlanSessionId Int
  quizId             Int
  optionSelected     String?

  studyPlanSession StudyPlanSession @relation(fields: [studyPlanSessionId], references: [id], onDelete: Cascade)
  quiz             Quiz             @relation(fields: [quizId], references: [id], onDelete: Restrict)

  @@unique([studyPlanSessionId, quizId])
  @@index([quizId])
}

enum StudyPlanSessionType {
  NORMAL
  SIMULACRO
  SPRINT
}

model Report {
  id     Int    @id @default(autoincrement())
  reason String @unique
  quizId Int
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model Info {
  id          Int    @id @default(0)
  title       String @unique
  description String @unique
}

enum UserRole {
  ADMIN
  USER
}
